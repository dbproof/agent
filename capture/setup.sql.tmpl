-- Stratum capture setup. Run once in the production database as the schema
-- owner, e.g.: psql -v password="$STRATUM_CAPTURE_PASSWORD" -f stratum-setup.sql
--
-- It creates a login role that can read the catalog and the {{.Tool}} history
-- table, and nothing else: no SELECT on any application table. Statistics
-- come from a security-definer function that returns row estimates, null
-- fractions, distinct counts and average widths, never values.

CREATE ROLE {{.Role}} LOGIN PASSWORD :'password';
GRANT USAGE ON SCHEMA {{.HistorySchema}} TO {{.Role}};
GRANT SELECT ON {{.HistoryTable}} TO {{.Role}};

CREATE SCHEMA IF NOT EXISTS stratum;
CREATE OR REPLACE FUNCTION stratum.table_stats()
  RETURNS TABLE (schema_name text, table_name text, n_rows real, column_name text,
                 null_frac real, n_distinct real, avg_width integer)
  LANGUAGE sql STABLE SECURITY DEFINER
  SET search_path = pg_catalog, pg_temp
AS $$
  SELECT DISTINCT ON (n.nspname, c.relname, s.attname)
         n.nspname::text, c.relname::text, c.reltuples, s.attname::text,
         s.null_frac, s.n_distinct, s.avg_width
  FROM pg_class c
  JOIN pg_namespace n ON n.oid = c.relnamespace
  LEFT JOIN pg_stats s ON s.schemaname = n.nspname AND s.tablename = c.relname
  WHERE c.relkind IN ('r', 'p', 'm')
    AND n.nspname NOT IN ('pg_catalog', 'information_schema', 'stratum')
    AND n.nspname NOT LIKE 'pg\_%'
  ORDER BY n.nspname, c.relname, s.attname, s.inherited
$$;
REVOKE ALL ON FUNCTION stratum.table_stats() FROM PUBLIC;
GRANT USAGE ON SCHEMA stratum TO {{.Role}};
GRANT EXECUTE ON FUNCTION stratum.table_stats() TO {{.Role}};
